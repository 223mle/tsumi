#!/usr/bin/env python3
"""Run eval cases (evals/cases/*.yaml) with the Cursor CLI or Claude Code. Judges which
skill and playbook .md files the agent read, from its stream-json output, and checks the
session-insights JSON in the final reply (insights_valid, insight_match, insight_absent).
A prompt may use {{TSUMI}} for this repo's path, so a command-only skill can be handed to the agent.

Usage:
  evals/bin/run-trigger --pstack <pstack plugin dir> [--harness cursor|claude]
                        [--trials 3] [--model M] [--effort E] [--jobs 4]
                        [--case trigger-clear-japanese-001] [--timeout 300]
                        [--changed [BASE]] [--early-stop | --full]
  Per change:  --changed --early-stop   (cases whose targets the diff touches; stop at 1 pass)
  Before a PR: --full                   (every case, 3 trials each)
Results go to evals/runs/<JST time>-<git sha>/ (git-ignored).
cursor: needs a logged-in CLI (`agent status`).
claude: loads only pstack and this repo (--setting-sources project), so personal
        skills, user plugins, and CLAUDE.md stay out of the run. The agent can read
        pstack and this repo's skills/ and agents/, not the cases or docs.
A must_read check on a file this repo ships passes only when the agent read this
repo's copy, not a same-named personal copy. No third-party Python packages.
"""
import argparse, concurrent.futures, datetime, threading, time, fnmatch, json, os, pathlib, re, shutil, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.dont_write_bytecode = True  # keep __pycache__ out of the shipped skill dir
sys.path.insert(0, str(ROOT / "skills/session-insights/scripts"))
import check_insights  # noqa: E402  the skill's own validator, so the eval and the skill agree


def load_case(path):
    """Minimal parser for our case files: scalars, `prompt: |` block, checks list."""
    checks = []
    case, lines = {"checks": checks}, path.read_text(encoding="utf-8").splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        m = re.match(r"^(\w+):\s*(.*)$", line)
        if m and m.group(2) == "|":
            block, i = [], i + 1
            while i < len(lines) and (lines[i].startswith("  ") or not lines[i].strip()):
                block.append(lines[i][2:])
                i += 1
            case[m.group(1)] = "\n".join(block).strip() + "\n"
            continue
        if m and m.group(1) == "checks":
            i += 1
            while i < len(lines) and lines[i].startswith("  "):
                kv = re.match(r"^\s*(?:-\s*)?(\w+):\s*(.*)$", lines[i])
                if kv:
                    if lines[i].lstrip().startswith("-"):
                        checks.append({})
                    checks[-1][kv.group(1)] = scalar(kv.group(2))
                i += 1
            continue
        if m:
            case[m.group(1)] = m.group(2).strip()
        i += 1
    return case


def scalar(v):
    """`"x"` -> x, `[a, b]` -> [a, b], anything else -> stripped string."""
    v = v.strip()
    if v.startswith("[") and v.endswith("]"):
        return [scalar(x) for x in v[1:-1].split(",") if x.strip()]
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
        return v[1:-1]
    return v


def events(stdout):
    for line in stdout.splitlines():
        try:
            yield json.loads(line)
        except ValueError:
            continue


def cursor_cmd(args, work):
    cmd = [args.cli, "-p", "--output-format", "stream-json", "--trust", "--mode", "ask",
           "--workspace", str(work), "--plugin-dir", args.pstack, "--plugin-dir", str(ROOT)]
    return cmd + (["--model", args.model] if args.model else [])


def cursor_reads(stdout):
    def collect(obj, tools, paths):
        if isinstance(obj, dict):
            for k, v in obj.items():
                if k.endswith("ToolCall") and isinstance(v, dict):
                    tools.add(k)
                if isinstance(v, str) and v.endswith(".md"):
                    paths.add(v)
                collect(v, tools, paths)
        elif isinstance(obj, list):
            for v in obj:
                collect(v, tools, paths)

    tools, paths, reply = set(), set(), ""
    for ev in events(stdout):
        if ev.get("type") == "tool_call":
            collect(ev, tools, paths)
        if ev.get("type") == "result":
            reply = ev.get("result", "")
    return tools, paths, reply


def claude_cmd(args, work):
    cmd = [args.cli, "-p", "--output-format", "stream-json", "--verbose", "--no-session-persistence",
           "--setting-sources", "project", "--permission-mode", "dontAsk",
           "--plugin-dir", args.pstack, "--plugin-dir", str(ROOT),
           "--add-dir", args.pstack, str(ROOT / "skills"), str(ROOT / "agents")]
    cmd += ["--model", args.model] if args.model else []
    return cmd + (["--effort", args.effort] if args.effort else [])


def claude_reads(stdout, pstack):
    """Read file paths and Skill invocations that did not error. A skill invoked as
    `plugin:name` counts as reading that plugin's skills/<name>/SKILL.md."""
    roots = {"tsumi": ROOT, "pstack": pathlib.Path(pstack)}
    calls, failed, reply = {}, set(), ""
    for ev in events(stdout):
        if ev.get("type") == "result":
            reply = ev.get("result", "")
        message = ev.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        for block in content if isinstance(content, list) else []:
            if block.get("type") == "tool_use":
                calls[block.get("id")] = block
            elif block.get("type") == "tool_result" and block.get("is_error"):
                failed.add(block.get("tool_use_id"))
    tools, paths = set(), set()
    for call_id, block in calls.items():
        tools.add(block.get("name"))
        if call_id in failed:
            continue
        args = block.get("input") or {}
        if block.get("name") == "Read" and args.get("file_path"):
            paths.add(args["file_path"])
        elif block.get("name") == "Skill" and args.get("skill"):
            plugin, _, name = args["skill"].rpartition(":")
            base = roots.get(plugin, pathlib.Path.home() / ".claude")
            paths.add(str(base / "skills" / name / "SKILL.md"))
    return tools, paths, reply


HARNESSES = {
    "cursor": {"cli": os.path.expanduser("~/.local/bin/agent"), "cmd": cursor_cmd,
               "reads": lambda stdout, args: cursor_reads(stdout), "stdin": False},
    "claude": {"cli": "claude", "cmd": claude_cmd,
               "reads": lambda stdout, args: claude_reads(stdout, args.pstack), "stdin": True},
}


def ships(glob):
    """True when the glob names a file in this repo's skills/, so the check is about tsumi's copy."""
    return any(fnmatch.fnmatch(str(p), glob) for p in (ROOT / "skills").rglob("*") if p.is_file())


def insights(reply):
    try:
        result = check_insights.extract(reply)
    except ValueError:
        return None
    return result if isinstance(result, dict) else None


def matching(check, reply):
    """Insights whose summary, evidence, or proposal match `match` (case-insensitive)."""
    result = insights(reply)
    if result is None:
        return None
    rx = re.compile(check["match"], re.I)
    def text(i):
        p = i.get("proposal") or {}
        return " ".join([str(i.get("summary", "")), str(p.get("change", "")), str(p.get("target", ""))] +
                        [str(e.get("quote", "")) for e in i.get("evidence", []) if isinstance(e, dict)])
    return [i for i in result.get("insights", []) if isinstance(i, dict) and rx.search(text(i))]


def judge_match(check, reply):
    """Some insight matches `match`, has a `kind` in `kind` (if given), and a proposal
    target matching `target` (if given)."""
    hits = matching(check, reply)
    if hits is None:
        return False, "no insights JSON"
    if not hits:
        return False, f"no insight matches /{check['match']}/"
    kinds = check.get("kind") or []
    ok = [i for i in hits if (not kinds or i.get("kind") in kinds) and
          (not check.get("target") or re.search(check["target"], str((i.get("proposal") or {}).get("target", "")), re.I))]
    detail = f"{[(i.get('id'), i.get('kind'), (i.get('proposal') or {}).get('target')) for i in hits]}"
    return bool(ok), detail


def judge(check, paths, reply="", prompt=""):
    if check["type"] == "insights_valid":
        errs = check_insights.check(reply, conversation=prompt)
        return {**check, "pass": not errs, "detail": "; ".join(errs[:5])}
    if check["type"] == "insight_match":
        ok, detail = judge_match(check, reply)
        return {**check, "pass": ok, "detail": detail}
    if check["type"] == "insight_absent":
        hits = matching(check, reply)
        return {**check, "pass": hits == [], "detail": "no insights JSON" if hits is None else str([i.get("id") for i in hits])}
    hits = [p for p in paths if fnmatch.fnmatch(p, check["glob"])]
    own = [p for p in hits if os.path.realpath(p).startswith(str(ROOT) + "/")]
    if check["type"] == "must_read":
        ok = bool(own) if ships(check["glob"]) else bool(hits)
    elif check["type"] == "must_not_read":
        ok = not hits
    else:
        ok = None
    return {**check, "pass": ok, "tsumi_copy": bool(own)}


RATE_LIMIT = re.compile(r"rate.?limit|too many requests|\b429\b|overloaded|usage limit|quota", re.I)


def rate_limited(code, stdout, stderr):
    """A trial the provider refused, not one the agent failed. Only for non-zero exits
    with no result event, so a reply that merely mentions "429" is not retried."""
    return code != 0 and '"type":"result"' not in stdout.replace(" ", "") and bool(
        RATE_LIMIT.search((stderr or "") + stdout[-2000:]))


def run_trial(case, args, out):
    """Run one trial; retry provider refusals (rate limit) with backoff, up to 3 times."""
    for attempt in range(4):
        trial = run_once(case, args, out)
        if not trial.get("rate_limited") or attempt == 3:
            trial["retries"] = attempt
            (out / "trial.json").write_text(json.dumps(trial, ensure_ascii=False, indent=1))
            return trial
        time.sleep(30 * (attempt + 1))


def run_once(case, args, out):
    harness = HARNESSES[args.harness]
    work = pathlib.Path(tempfile.mkdtemp()) / "acme-notes"
    work.mkdir()
    cmd = harness["cmd"](args, work)
    prompt = case["prompt"].replace("{{TSUMI}}", str(ROOT))
    stdin = prompt if harness["stdin"] else None
    if stdin is None:
        cmd = cmd + [prompt]
    out.mkdir(parents=True, exist_ok=True)
    started = time.time()
    (out / "cmd.json").write_text(json.dumps(cmd, ensure_ascii=False, indent=1))
    try:
        p = subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=args.timeout, cwd=work)
        stdout, stderr, code = p.stdout, p.stderr, p.returncode
    except subprocess.TimeoutExpired as e:
        stdout, stderr, code = (e.stdout or b"").decode() if isinstance(e.stdout, bytes) else (e.stdout or ""), "timeout", "timeout"
    (out / "stream.jsonl").write_text(stdout)
    (out / "stderr.txt").write_text(stderr or "")
    tools, paths, reply = harness["reads"](stdout, args)
    results = [judge(c, paths, reply, case["prompt"]) for c in case["checks"]]
    trial = {"exit": code, "skills_read": sorted(paths), "tools": sorted(tools),
             "checks": results, "pass": code == 0 and all(r["pass"] for r in results),
             "rate_limited": code != "timeout" and rate_limited(code, stdout, stderr), "seconds": round(time.time() - started, 1)}
    (out / "trial.json").write_text(json.dumps(trial, ensure_ascii=False, indent=1))
    (out / "reply.txt").write_text(reply)
    shutil.rmtree(work.parent, ignore_errors=True)
    return trial


# Paths whose change can affect every case: the router, the runner, schemas, manifests.
GLOBAL = ("skills/tsumi-mode/", "evals/bin/", "evals/schemas/", "evals/fixtures/", "evals/rubrics/",
          ".cursor-plugin/", ".claude-plugin/", "agents/")
# Paths that never change agent behaviour.
INERT = ("README.md", "CONTRIBUTING.md", "DESIGN.md", "docs/", "research/", "evals/README.md",
         "scripts/", ".github/", ".gitignore", "evals/runs/")
# Files a skill reads at run time that live outside its directory.
EXTRA = {"corrections.tsv": "session-insights"}


def select_changed(cases, base):
    """Return (cases to run, reasons). Any path we cannot map runs everything."""
    diff = subprocess.run(["git", "-C", str(ROOT), "diff", "--name-only", base], capture_output=True, text=True)
    if diff.returncode:
        sys.exit(f"git diff {base} failed: {diff.stderr.strip()}")
    untracked = subprocess.run(["git", "-C", str(ROOT), "ls-files", "--others", "--exclude-standard"],
                               capture_output=True, text=True).stdout
    files = sorted(set(diff.stdout.split()) | set(untracked.split()))
    picked, reasons = {}, []
    for f in files:
        if f.startswith(INERT) or f in INERT:
            reasons.append(f"skip  {f} (does not change behaviour)")
            continue
        if f.startswith(GLOBAL):
            reasons.append(f"ALL   {f} (shared by every case)")
            return cases, reasons
        m = re.match(r"skills/([^/]+)/", f)
        skill = m.group(1) if m else EXTRA.get(f)
        if f.startswith("evals/cases/"):
            hit = [c for c in cases if c["file"].name == pathlib.Path(f).name]
            why = "case file"
        elif skill:
            hit = [c for c in cases if skill in c.get("targets", [])]
            why = f"targets {skill}"
        else:
            reasons.append(f"ALL   {f} (no mapping; running everything to be safe)")
            return cases, reasons
        for c in hit:
            picked[c["id"]] = c
        reasons.append(f"pick  {f} ({why}): {', '.join(c['id'] for c in hit) or 'no case'}")
    return [c for c in cases if c["id"] in picked], reasons


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--pstack", required=True)
    ap.add_argument("--harness", choices=sorted(HARNESSES), default="cursor")
    ap.add_argument("--trials", type=int, default=3)
    ap.add_argument("--model")
    ap.add_argument("--effort")
    ap.add_argument("--case", action="append")
    ap.add_argument("--timeout", type=int, default=300)
    ap.add_argument("--cli")
    ap.add_argument("--jobs", type=int, default=4, help="trials run in parallel (default 4)")
    ap.add_argument("--changed", nargs="?", const="origin/main", metavar="BASE",
                    help="only cases whose targets the diff against BASE touches (default origin/main)")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--early-stop", action="store_true",
                      help="stop a case after a passing first trial; on a fail, run all --trials")
    mode.add_argument("--full", action="store_true", help="before a PR: every case, 3 trials, no early stop")
    args = ap.parse_args()
    if args.full:
        if args.changed or args.case:
            ap.error("--full runs every case; drop --changed/--case")
        args.trials = 3
    if args.trials < 1 or args.jobs < 1:
        ap.error("--trials and --jobs must be at least 1")
    args.cli = args.cli or HARNESSES[args.harness]["cli"]
    cases = []
    for f in sorted((ROOT / "evals/cases").glob("*.yaml")):
        c = load_case(f)
        c["file"], c["targets"] = f, scalar(c.get("targets", "[]")) if isinstance(c.get("targets"), str) else c.get("targets", [])
        cases.append(c)
    if args.case:
        cases = [c for c in cases if c["file"].stem in args.case]
    if args.changed:
        cases, reasons = select_changed(cases, args.changed)
        print(f"--changed {args.changed}:")
        print("\n".join("  " + r for r in reasons) or "  no changed files")
        print(f"  -> {len(cases)} case(s): {', '.join(c['id'] for c in cases)}", flush=True)
        if not cases:
            print("nothing to run")
            sys.exit(0)
    if not cases:
        ap.error("no cases matched")
    sha = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
    dirty = subprocess.run(["git", "-C", str(ROOT), "status", "--porcelain"], capture_output=True, text=True).stdout.strip()
    stamp = datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=9))).strftime("%Y%m%d-%H%M%S")
    run_dir = ROOT / "evals/runs" / f"{stamp}-{sha}{'-dirty' if dirty else ''}-{args.harness}"
    run_dir.mkdir(parents=True, exist_ok=True)
    started = time.time()
    results = {c["id"]: {} for c in cases}
    lock = threading.Lock()
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
        def submit(c, t):
            return pool.submit(run_trial, c, args, run_dir / c["id"] / str(t)), c, t
        # Early stop: trial 1 first, the rest only if it fails. Otherwise all trials up front.
        first = range(1, 2) if args.early_stop else range(1, args.trials + 1)
        pending = {}
        for c in cases:
            for t in first:
                fut, c_, t_ = submit(c, t)
                pending[fut] = (c_, t_)
        while pending:
            done, _ = concurrent.futures.wait(pending, return_when=concurrent.futures.FIRST_COMPLETED)
            for fut in done:
                c, t = pending.pop(fut)
                trial = fut.result()
                with lock:
                    results[c["id"]][t] = trial
                if args.early_stop and t == 1 and not trial["pass"]:
                    for t2 in range(2, args.trials + 1):
                        f2, c2, tt = submit(c, t2)
                        pending[f2] = (c2, tt)
    summary = []
    for c in cases:
        trials = [results[c["id"]][t] for t in sorted(results[c["id"]])]
        n = sum(t["pass"] for t in trials)
        verdict = "pass" if n == len(trials) else "fail" if n == 0 else "flaky"
        stopped = args.early_stop and len(trials) < args.trials
        summary.append({"id": c["id"], "verdict": verdict, "passed": n, "trials": len(trials),
                        "early_stopped": stopped, "rate_limit_retries": sum(t.get("retries", 0) for t in trials),
                        "seconds": [t.get("seconds") for t in trials],
                        "skills_read": [t["skills_read"] for t in trials],
                        "checks": [[{k: r[k] for k in ("type", "glob", "match", "pass", "tsumi_copy", "detail") if k in r} for r in t["checks"]] for t in trials]})
        note = " (early stop)" if stopped else ""
        print(f"{verdict:6} {n}/{len(trials)} {c['id']}{note}", flush=True)
    (run_dir / "summary.json").write_text(json.dumps(summary, ensure_ascii=False, indent=1))
    print(f"wall: {round(time.time() - started)}s, jobs={args.jobs}, mode={'full' if args.full else 'early-stop' if args.early_stop else 'fixed'}")
    print(f"results: {run_dir}")
    sys.exit(0 if all(s["verdict"] == "pass" for s in summary) else 1)


if __name__ == "__main__":
    main()
