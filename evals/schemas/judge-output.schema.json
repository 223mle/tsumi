{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "tsumi/evals/judge-output.schema.json",
	"title": "tsumi judge output (draft)",
	"type": "object",
	"additionalProperties": false,
	"required": ["label", "criteria"],
	"properties": {
		"label": { "type": "string", "description": "匿名ラベル。モデル名は入れない" },
		"criteria": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["criterion", "pass", "reason"],
				"properties": {
					"criterion": { "type": "string" },
					"pass": { "type": "boolean" },
					"reason": { "type": "string", "maxLength": 200 }
				}
			}
		}
	}
}
