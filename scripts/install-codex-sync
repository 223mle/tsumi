#!/usr/bin/env python3
import json
import os
from pathlib import Path
import shlex
import subprocess
import tempfile


def write_atomic(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as tmp:
        tmp.write(data)
    try:
        os.replace(tmp.name, path)
    finally:
        Path(tmp.name).unlink(missing_ok=True)


def is_tsumi_link(path, home, state):
    return path.is_symlink() and os.readlink(path) in (str(state / "current" / "skills" / path.name), str(home / "tsumi" / "skills" / path.name))


def is_pstack_unslop(path):
    parts = Path(os.readlink(path)).parts if path.is_symlink() else ()
    return path.name == "unslop" and parts[-2:] == ("skills", "unslop") and "pstack" in parts


def main():
    home = Path.home()
    state = home / ".codex" / "tsumi"
    script = state / "sync-codex-skills"
    hooks_path = home / ".codex" / "hooks.json"
    config = json.loads(hooks_path.read_text()) if hooks_path.exists() else {}
    names = ("unslop", "agent-design-review", "tsumi-mode")
    retired = ("clear-japanese",)
    links = {home / ".agents" / "skills" / name: state / "current" / "skills" / name for name in names}
    stale = [path for path in (home / ".agents" / "skills" / name for name in retired) if is_tsumi_link(path, home, state)]
    previous = {}
    for path, target in links.items():
        if path.exists() or path.is_symlink():
            if not is_tsumi_link(path, home, state) and not is_pstack_unslop(path):
                raise SystemExit("Refusing to replace an unrelated skill: " + str(path))
            previous[str(path)] = os.readlink(path)
    for path in stale:
        previous[str(path)] = os.readlink(path)
    hook = {
        "type": "command",
        "command": "/usr/bin/python3 " + shlex.quote(str(script)),
        "timeout": 30,
        "statusMessage": "Checking tsumi skill updates",
    }
    groups = config.setdefault("hooks", {}).setdefault("SessionStart", [])
    if not any(h.get("command") == hook["command"] for g in groups for h in g.get("hooks", [])):
        groups.append({"matcher": "^(startup|resume)$", "hooks": [hook]})
    state.mkdir(parents=True, exist_ok=True)
    backup = state / "install-backup.json"
    saved = json.loads(backup.read_text()) if backup.exists() else {"links": {}, "hooks": hooks_path.read_text() if hooks_path.exists() else None}
    if not backup.exists() or any(path not in saved["links"] for path in previous):
        saved["links"] = {**previous, **saved["links"]}
        write_atomic(backup, json.dumps(saved, ensure_ascii=False, indent=2) + "\n")
    source = Path(__file__).resolve().with_name("sync-codex-skills")
    write_atomic(script, source.read_text())
    subprocess.run(["/usr/bin/python3", str(script)], check=True)
    for path in stale:
        path.unlink()
    for path, target in links.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.is_symlink() and os.readlink(path) == str(target):
            continue
        with tempfile.TemporaryDirectory(dir=path.parent) as tmp:
            link = Path(tmp) / path.name
            link.symlink_to(target, target_is_directory=True)
            os.replace(link, path)
    write_atomic(hooks_path, json.dumps(config, ensure_ascii=False, indent=2) + "\n")
    print("Installed and updated. Review and trust the new hook in Codex Hooks settings.")
    print("Update log: " + str(state / "update.log"))


if __name__ == "__main__":
    main()
